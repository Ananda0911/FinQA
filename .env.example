# DashScope API Key（阿里云百炼 https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=

# 可选：云端 MinerU 高精度解析 Token（https://mineru.net 注册后在「API 令牌管理」申请）
# 每天 2000 页免费最高优先级额度；配置后可在入库页选择「mineru_cloud」解析后端
MINERU_API_TOKEN=

# 可选：模型覆盖
# FINQA_LLM_MODEL=qwen-plus
# FINQA_EMBED_MODEL=text-embedding-v3
# FINQA_RERANK_MODEL=gte-rerank-v2
# 可选：云端 MinerU 模型版本 vlm（默认，质量高）| pipeline（更快）
# FINQA_MINERU_MODEL=vlm
